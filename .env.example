GROQ_API_KEY_1=...
GROQ_API_KEY_2=...
GROQ_API_KEY_3=...

CASPIAN_API_KEY=...
CASPIAN_BASE_URL=...
TELEGRAM_BOT_TOKEN=...

# Signs the login session cookie. Fully optional -- if unset, it's derived
# from CASPIAN_API_KEY instead, which stays stable across a redeploy even
# on a host like Render whose filesystem is wiped every deploy, so logins
# survive pushes without setting anything here. Only set this if you want
# the session key independent of CASPIAN_API_KEY specifically.
FLASK_SECRET_KEY=...

# Gmail connect (Connect tab) AND real "Sign in with Google" for account
# login both use this same OAuth client, just with different scopes. Create
# a project at console.cloud.google.com, enable the Gmail API, add an OAuth
# client ID (type: Web application), and add BOTH of these exact redirect
# URIs under "Authorized redirect URIs" there (one per deployment, e.g. add
# the localhost ones for local dev and the matching https://<your-render-
# domain>/... ones for the deployed site):
#   <origin>/api/google/callback           (Gmail-connect)
#   <origin>/api/google/account/callback   (account sign-in)
# Leave these blank and the buttons just explain this setup instead of
# failing silently.
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REDIRECT_URI=...

# Slack connect. Create an app at api.slack.com/apps (From scratch), add
# a redirect URL under OAuth & Permissions matching this exact value, and
# add the user token scopes there too (see oauth_connections.py's "slack"
# entry for the exact scope list this app requests).
SLACK_OAUTH_CLIENT_ID=...
SLACK_OAUTH_CLIENT_SECRET=...
SLACK_OAUTH_REDIRECT_URI=...

# LinkedIn connect. Create an app at developer.linkedin.com with the
# "Sign In with LinkedIn using OpenID Connect" product added (this only
# grants basic profile/email, LinkedIn's own partner approval is needed
# for anything broader like reading your network).
LINKEDIN_OAUTH_CLIENT_ID=...
LINKEDIN_OAUTH_CLIENT_SECRET=...
LINKEDIN_OAUTH_REDIRECT_URI=...

# GitHub connect is different: no app registration needed, the Connect
# button in the app just asks you to paste a personal access token you
# generate yourself at github.com/settings/tokens (no scopes required for
# public profile data). Nothing to set here.

# How often the Map agent rechecks hiring/funding/similar companies for
# every researched company in the background, in seconds. Optional,
# defaults to 3 hours (10800) if unset.
MAP_REFRESH_INTERVAL_SECONDS=...
